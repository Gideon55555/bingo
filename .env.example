# --- Telegram ---
# Get this from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS URL where this server is reachable (the Mini App URL)
WEBAPP_URL=https://your-app.example.com
# Comma-separated Telegram user ids of admins who approve deposits/withdrawals.
# Send /id to your bot to find yours.
ADMIN_IDS=123456789

PORT=3000
DB_PATH=./data/bingo.db

# --- Game ---
STAKES=10,20,50,100
CARD_COUNT=100
MIN_PLAYERS=2
COUNTDOWN_SEC=30
CALL_INTERVAL_MS=3500
RESULT_SHOW_SEC=8
# Fraction of each pot kept by the house (0.2 = 20%)
HOUSE_CUT=0.2

# --- Wallet ---
CURRENCY=ETB
# Shown to players on the deposit screen
PAYMENT_INFO=Telebirr: 0911000000 (Your Name) | CBE: 1000000000000 (Your Name)
MIN_DEPOSIT=10
MIN_WITHDRAW=50

# Lets you open the app in a normal browser with ?dev_user=1 (no Telegram needed).
# NEVER set to true in production.
DEV_MODE=false
