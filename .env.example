# =====================================================================
#  Bingo configuration. Copy to .env and fill in.  NEVER commit .env.
# =====================================================================

# "production" turns on safety checks (refuses DEV_MODE, requires https URL, etc.)
NODE_ENV=production

# --- Telegram ---
# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS address of this app, e.g. https://bingo.yourdomain.com
WEBAPP_URL=https://bingo.yourdomain.com
# Comma-separated Telegram user ids of admins (send /id to your bot to find yours)
ADMIN_IDS=123456789
# Password for the browser admin panel at https://bingo.yourdomain.com/admin (min 8 chars, make it long)
ADMIN_PASSWORD=change-me-to-something-long
# polling = simple, best on a VPS.  webhook = required on shared hosting (DirectAdmin / cPanel Node.js apps)
BOT_MODE=polling

PORT=3000
DB_PATH=./data/bingo.db
# Used for "today" in stats and for backup times
TIMEZONE=Africa/Addis_Ababa

# --- Game ---
STAKES=10,20,50,100
CARD_COUNT=100
MIN_PLAYERS=2
COUNTDOWN_SEC=30
CALL_INTERVAL_MS=3500
RESULT_SHOW_SEC=8
# Fraction of each pot kept by the house (0.2 = 20%)
HOUSE_CUT=0.2

# --- Wallet ---
CURRENCY=ETB
# Shown to players on the deposit screen
PAYMENT_INFO=Telebirr: 0911000000 (Your Name) | CBE: 1000000000000 (Your Name)
MIN_DEPOSIT=10
MAX_DEPOSIT=100000
MIN_WITHDRAW=50
# A player can't have more than this many requests waiting at once
MAX_PENDING_DEPOSITS=3
MAX_PENDING_WITHDRAWALS=2

# --- Crash game (plane) ---  amounts in ETB
CRASH_ENABLED=true
# Name shown to players
CRASH_NAME=Aviator
# House edge: 0.03 = players get back 97% of bets on average
CRASH_HOUSE_EDGE=0.03
CRASH_MIN_BET=5
CRASH_MAX_BET=5000
# Biggest payout a single bet can receive (protects you from huge multipliers)
CRASH_MAX_WIN=100000
# Seconds of betting time before each take-off
CRASH_BET_SEC=7
# Highest possible multiplier
CRASH_MAX_MULTIPLIER=1000

# --- 8-ball pool (1 vs 1) ---  amounts in ETB
POOL_ENABLED=true
POOL_STAKES=10,20,50,100
# Players per table: 2 = 8-ball. Add 3–6 for Cutthroat tables (e.g. 2,3,4). Default: 1 vs 1 only.
POOL_SIZES=2
POOL_HOUSE_CUT=0.1
# Seconds per shot
POOL_SHOT_SEC=30
# Timeouts in a row before a player forfeits
POOL_MAX_MISSES=3

# --- Ludo (player vs player) ---  amounts in ETB
LUDO_ENABLED=true
# Entry fee tables; each has a 1-vs-1 and a 4-player version
LUDO_STAKES=10,20,50,100
# Your share of each pot (0.1 = 10%)
LUDO_HOUSE_CUT=0.1
# Tokens per player (2 = quick games, 4 = classic)
LUDO_TOKENS=2
# Seconds per turn before the server plays for you
LUDO_TURN_SEC=15
# Missed turns in a row before a player forfeits
LUDO_MAX_MISSES=3

# --- Keno ---  amounts in ETB
KENO_ENABLED=true
KENO_MIN_BET=5
KENO_MAX_BET=2000
# Biggest payout a single ticket can receive
KENO_MAX_WIN=100000
# Seconds tickets are open before each draw
KENO_BET_SEC=40
# Milliseconds between drawn balls (20 balls)
KENO_BALL_MS=600
# Seconds the result stays on screen
KENO_RESULT_SEC=7

# --- Player info (shown on the Rules screen) ---
# Name in the app header (leave empty to show "Games" / "ጨዋታዎች")
APP_NAME=
# e.g. @YourSupportUsername or a phone number
SUPPORT_CONTACT=@your_support
MIN_AGE=18

# --- Backups ---
BACKUP_DIR=./backups
# How many daily backups to keep on the server
BACKUP_KEEP=14
# Hour of the day (local time) to run the daily backup
BACKUP_HOUR=4
# Also send each daily backup file to the admins on Telegram (off-server copy)
BACKUP_TO_TELEGRAM=true

# Lets you open the app in a normal browser with ?dev_user=1 (no Telegram).
# ONLY for local testing. The server refuses to start with this on when NODE_ENV=production.
DEV_MODE=false
